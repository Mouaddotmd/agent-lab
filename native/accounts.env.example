# Agent Lab's account service. Copy to accounts.env (git ignores it), fill in, then run ./build.sh.
# See docs/accounts.md for where each value comes from.
AGENTLAB_AUTH_URL=https://YOUR-PROJECT.supabase.co
AGENTLAB_AUTH_KEY=your-publishable-key
AGENTLAB_GOOGLE_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
AGENTLAB_GOOGLE_CLIENT_SECRET=your-desktop-client-secret
AGENTLAB_PRIVACY_URL=
